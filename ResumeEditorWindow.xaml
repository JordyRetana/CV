<Window x:Class="CVDesktopEditor.ResumeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resume Editor"
        Height="920"
        Width="1250"
        Icon="/Assets/appicon.ico"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource AppBgBrush}">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0C1324" CornerRadius="18" Padding="24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="TxtTitle"
                               Text="Editor"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock x:Name="TxtSubtitle"
                               Margin="0,8,0,0"
                               Text="Edita una seccion a la vez y guarda los cambios localmente."
                               FontSize="14"
                               Foreground="#D0D5DD"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Vista previa"
                            Width="130"
                            Height="42"
                            Margin="0,0,10,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BtnPreview_Click"/>
                    <Button Content="Guardar"
                            Width="120"
                            Height="42"
                            Margin="0,0,10,0"
                            Click="BtnSave_Click"/>
                    <Button Content="Cerrar"
                            Width="120"
                            Height="42"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="18" Padding="18">
            <TabControl>
                <TabItem Header="Datos">
                    <ScrollViewer>
                        <StackPanel>
                            <TextBlock Text="Datos base" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>

                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,12,12">
                                    <TextBlock Text="Nombre completo" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Height="42"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Ubicacion" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" Height="42"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,12,12">
                                    <TextBlock Text="Telefono" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Height="42"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Correo" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Height="42"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,12,12">
                                    <TextBlock Text="Portafolio" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding Portfolio, UpdateSourceTrigger=PropertyChanged}" Height="42"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="LinkedIn" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding LinkedIn, UpdateSourceTrigger=PropertyChanged}" Height="42"/>
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock Text="Resumen profesional" FontWeight="SemiBold" Margin="0,8,0,6"/>
                            <TextBox Text="{Binding ProfessionalSummary, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     MinHeight="180"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Experiencia">
                    <ScrollViewer>
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Experiencia" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Anadir experiencia" Width="180" Height="42" Click="BtnAddExperience_Click"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Experience}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource PanelBrush}"
                                                BorderBrush="{StaticResource BorderBrushSoft}"
                                                BorderThickness="1"
                                                CornerRadius="14"
                                                Padding="18"
                                                Margin="0,0,0,14">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Company}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Content="Eliminar" Width="105" Height="36" Style="{StaticResource DangerButtonStyle}" Tag="{Binding}" Click="BtnRemoveExperience_Click"/>
                                                </Grid>

                                                <UniformGrid Columns="2">
                                                    <StackPanel Margin="0,0,12,12">
                                                        <TextBlock Text="Empresa" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                        <TextBox Text="{Binding Company, UpdateSourceTrigger=PropertyChanged}" Height="42"/>
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,0,12">
                                                        <TextBlock Text="Puesto" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                        <TextBox Text="{Binding Position, UpdateSourceTrigger=PropertyChanged}" Height="42"/>
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Text="Ubicacion" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                        <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" Height="42"/>
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="Periodo" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                        <TextBox Text="{Binding Period, UpdateSourceTrigger=PropertyChanged}" Height="42"/>
                                                    </StackPanel>
                                                </UniformGrid>

                                                <Grid Margin="0,18,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Responsabilidades" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Content="Anadir punto" Width="130" Height="36" Style="{StaticResource SecondaryButtonStyle}" Tag="{Binding}" Click="BtnAddResponsibility_Click"/>
                                                </Grid>

                                                <ItemsControl ItemsSource="{Binding Responsibilities}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="8"/>
                                                                    <ColumnDefinition Width="44"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" MinHeight="58"/>
                                                                <Button Grid.Column="2" Content="X" Height="38" Style="{StaticResource DangerButtonStyle}" Tag="{Binding}" Click="BtnRemoveResponsibility_Click"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Proyectos">
                    <ScrollViewer>
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Proyectos" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Anadir proyecto" Width="170" Height="42" Click="BtnAddProject_Click"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Projects}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,14">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Content="Eliminar" Width="105" Height="36" Style="{StaticResource DangerButtonStyle}" Tag="{Binding}" Click="BtnRemoveProject_Click"/>
                                                </Grid>

                                                <UniformGrid Columns="2">
                                                    <StackPanel Margin="0,0,12,12">
                                                        <TextBlock Text="Titulo" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Height="42"/>
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,0,12">
                                                        <TextBlock Text="Rol" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                        <TextBox Text="{Binding Role, UpdateSourceTrigger=PropertyChanged}" Height="42"/>
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Text="Ubicacion" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                        <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" Height="42"/>
                                                    </StackPanel>
                                                </UniformGrid>

                                                <Grid Margin="0,18,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Detalles" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Content="Anadir detalle" Width="135" Height="36" Style="{StaticResource SecondaryButtonStyle}" Tag="{Binding}" Click="BtnAddProjectDetail_Click"/>
                                                </Grid>

                                                <ItemsControl ItemsSource="{Binding Details}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="8"/>
                                                                    <ColumnDefinition Width="44"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" MinHeight="58"/>
                                                                <Button Grid.Column="2" Content="X" Height="38" Style="{StaticResource DangerButtonStyle}" Tag="{Binding}" Click="BtnRemoveProjectDetail_Click"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Educacion">
                    <ScrollViewer>
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Educacion" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Anadir educacion" Width="175" Height="42" Click="BtnAddEducation_Click"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Education}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,14">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Institution}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Content="Eliminar" Width="105" Height="36" Style="{StaticResource DangerButtonStyle}" Tag="{Binding}" Click="BtnRemoveEducation_Click"/>
                                                </Grid>

                                                <UniformGrid Columns="2">
                                                    <StackPanel Margin="0,0,12,12">
                                                        <TextBlock Text="Institucion" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                        <TextBox Text="{Binding Institution, UpdateSourceTrigger=PropertyChanged}" Height="42"/>
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,0,12">
                                                        <TextBlock Text="Titulo" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                        <TextBox Text="{Binding Degree, UpdateSourceTrigger=PropertyChanged}" Height="42"/>
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,12,12">
                                                        <TextBlock Text="Descripcion" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Height="42"/>
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,0,12">
                                                        <TextBlock Text="Ubicacion" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                        <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" Height="42"/>
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Text="Periodo" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                        <TextBox Text="{Binding Period, UpdateSourceTrigger=PropertyChanged}" Height="42"/>
                                                    </StackPanel>
                                                </UniformGrid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Habilidades">
                    <ScrollViewer>
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Habilidades" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Anadir habilidad" Width="170" Height="42" Click="BtnAddSkill_Click"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Skills}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Height="42"/>
                                            <Button Grid.Column="2" Content="Eliminar" Height="42" Style="{StaticResource DangerButtonStyle}" Tag="{Binding}" Click="BtnRemoveSkill_Click"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <Border Grid.Row="4" Background="{StaticResource CardBrush}" CornerRadius="18" Padding="18">
            <DockPanel LastChildFill="False">
                <TextBlock Text="Guarda cuando termines de ajustar la seccion actual."
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Vista previa" Width="130" Height="42" Margin="0,0,10,0" Style="{StaticResource SecondaryButtonStyle}" Click="BtnPreview_Click"/>
                    <Button Content="Guardar" Width="120" Height="42" Margin="0,0,10,0" Click="BtnSave_Click"/>
                    <Button Content="Cerrar" Width="120" Height="42" Style="{StaticResource SecondaryButtonStyle}" Click="BtnClose_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
