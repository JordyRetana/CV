<Window x:Class="CVDesktopEditor.ResumeWebPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CVDesktopEditor.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Vista previa Harvard"
        Height="920"
        Width="1220"
        Icon="/Assets/appicon.ico"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        Background="{DynamicResource AppBgBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:AppTitleBar/>
    <Grid Grid.Row="1" Margin="28,20,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="Transparent" Padding="4,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="TxtHeader"
                               Text="Vista previa Harvard"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="TxtSubHeader"
                               Margin="0,8,0,0"
                               Text="Preview y PDF salen del mismo documento."
                               FontSize="14"
                               Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="BtnExportPdf"
                            Content="Exportar PDF"
                            Width="150"
                            Height="42"
                            Margin="0,0,10,0"
                            Click="BtnExportPdf_Click"
                            IsEnabled="False"/>
                    <Button Content="Cerrar"
                            Width="110"
                            Height="42"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{DynamicResource CardBrush}"
                CornerRadius="7"
                Padding="12">
            <wv2:WebView2 x:Name="PreviewWebView" />
        </Border>
    </Grid>
    </Grid>
</Window>
