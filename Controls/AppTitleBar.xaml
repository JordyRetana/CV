<UserControl x:Class="CVDesktopEditor.Controls.AppTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="52">
    <Border Background="{DynamicResource ChromeBrush}"
            BorderBrush="{DynamicResource BorderBrushSoft}"
            BorderThickness="0,0,0,1"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid Margin="18,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image Source="/Assets/appicon.ico" Width="24" Height="24" VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtWindowTitle" Grid.Column="1"
                       Margin="10,0,0,0" VerticalAlignment="Center"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnMinimize" Content="−" ToolTip="Minimizar"
                        Style="{StaticResource ChromeButtonStyle}"
                        Click="Minimize_Click"/>
                <Button x:Name="BtnMaximize" Content="□" ToolTip="Maximizar"
                        Style="{StaticResource ChromeButtonStyle}"
                        Click="Maximize_Click"/>
                <Button Content="×" ToolTip="Cerrar"
                        Style="{StaticResource ChromeButtonStyle}"
                        Foreground="{DynamicResource TextBrush}"
                        Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
