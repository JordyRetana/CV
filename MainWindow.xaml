<Window x:Class="CVDesktopEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CVDesktopEditor.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CV Desktop Editor"
        Height="720" Width="1100" MinHeight="520" MinWidth="620"
        Icon="/Assets/shortcut-icon.ico"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        Background="{DynamicResource AppBgBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:AppTitleBar/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="184"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderBrushSoft}"
                    BorderThickness="0,0,1,0">
                <Grid Margin="14,26,14,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="CV EDITOR" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock Text="Estudio" FontSize="27" FontWeight="SemiBold"
                                   Margin="0,7,0,0"/>
                        <TextBlock Text="Tu espacio de trabajo" FontSize="13"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="ESTADO" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"/>
                        <TextBlock Text="Licencia" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Name="TxtLicenseStatus" Text="Comprobando..."
                                   Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"
                                   FontSize="13" Margin="0,4,0,16"/>
                        <Button Content="Activar licencia" Height="42"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="BtnActivateLicense_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4">
                        <Button Name="BtnAdmin" Content="Panel admin" Height="42"
                                Visibility="Collapsed" Margin="0,0,0,8"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="BtnAdmin_Click"/>
                        <Button Name="BtnTheme" Content="Modo claro" Height="42"
                                Margin="0,0,0,8" Style="{StaticResource QuietButtonStyle}"
                                Click="BtnTheme_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="24,28,24,32" MaxWidth="840" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="MIS DOCUMENTOS" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="Tus currículums" FontSize="34" FontWeight="SemiBold"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="Selecciona un idioma para importar, editar o revisar el resultado."
                                   FontSize="14" Foreground="{DynamicResource MutedBrush}"
                                   Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Grid.Row="2" Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrushSoft}"
                            BorderThickness="1" CornerRadius="7" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="21"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="CV en español" FontSize="21" FontWeight="SemiBold"/>
                                    <TextBlock Text="Documento y vista previa" FontSize="13"
                                               Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/>
                                </StackPanel>
                                <TextBlock Name="TxtSpanishStatus" Grid.Column="1" Text="Sin PDF"
                                           Foreground="{DynamicResource AccentBrush}" FontSize="13"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <WrapPanel Grid.Row="2">
                                <Button Name="BtnImportSpanish" Content="Importar PDF" Width="126" Height="42"
                                        Margin="0,0,10,0" Click="BtnImportSpanish_Click"/>
                                <Button Name="BtnEditSpanish" Content="Editar" Width="110" Height="42"
                                        Margin="0,0,10,0" Style="{StaticResource SecondaryButtonStyle}"
                                        Click="BtnEditSpanish_Click"/>
                                <Button Name="BtnPreviewSpanish" Content="Vista previa" Width="128" Height="42"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="BtnPreviewSpanish_Click"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="4" Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrushSoft}"
                            BorderThickness="1" CornerRadius="7" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="21"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="CV en inglés" FontSize="21" FontWeight="SemiBold"/>
                                    <TextBlock Text="Documento y vista previa" FontSize="13"
                                               Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/>
                                </StackPanel>
                                <TextBlock Name="TxtEnglishStatus" Grid.Column="1" Text="Sin PDF"
                                           Foreground="{DynamicResource AccentBrush}" FontSize="13"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <WrapPanel Grid.Row="2">
                                <Button Name="BtnImportEnglish" Content="Importar PDF" Width="126" Height="42"
                                        Margin="0,0,10,0" Click="BtnImportEnglish_Click"/>
                                <Button Name="BtnEditEnglish" Content="Editar" Width="110" Height="42"
                                        Margin="0,0,10,0" Style="{StaticResource SecondaryButtonStyle}"
                                        Click="BtnEditEnglish_Click"/>
                                <Button Name="BtnPreviewEnglish" Content="Vista previa" Width="128" Height="42"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="BtnPreviewEnglish_Click"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Ajuste con IA" FontSize="19" FontWeight="SemiBold"/>
                            <TextBlock Text="Adapta el contenido a una oferta de trabajo."
                                       Foreground="{DynamicResource MutedBrush}" FontSize="13"
                                       Margin="0,5,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Name="BtnAiTailor" Grid.Column="1" Content="Abrir IA"
                                Width="130" Height="42" VerticalAlignment="Center"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="BtnAiTailor_Click"/>
                    </Grid>

                    <Grid Grid.Row="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tus datos se guardan en este equipo."
                                   FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}"/>
                        <Button Name="BtnClear" Grid.Column="1" Content="Borrar datos"
                                Height="38" Foreground="{DynamicResource DangerBrush}"
                                Style="{StaticResource QuietButtonStyle}"
                                Click="BtnClear_Click"/>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
