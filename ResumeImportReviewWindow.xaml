<Window x:Class="CVDesktopEditor.ResumeImportReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CVDesktopEditor.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Revisar importación" Height="710" Width="940"
        MinHeight="500" MinWidth="620"
        Icon="/Assets/appicon.ico"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="{DynamicResource AppBgBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:AppTitleBar/>
        <Grid Grid.Row="1" Margin="28,20,28,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Revisa la importación" FontSize="29" FontWeight="SemiBold"/>
                <TextBlock Name="TxtOrigin" Margin="0,6,0,0"
                           Foreground="{DynamicResource MutedBrush}" FontSize="14" TextWrapping="Wrap"/>
            </StackPanel>
            <TextBlock Name="TxtCounts" Grid.Row="2" FontSize="13"
                       Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/>
            <TextBox Name="TxtReview" Grid.Row="4"
                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top" FontSize="14"
                     Padding="18,14"/>
            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Nada se guardará hasta que confirmes. Podrás corregir campos en el editor."
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,18,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Cancelar" Width="120" Height="42" Margin="0,0,10,0"
                            Style="{StaticResource SecondaryButtonStyle}" Click="BtnCancel_Click"/>
                    <Button Content="Usar estos datos" Width="160" Height="42" Click="BtnConfirm_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
