<Window x:Class="CVDesktopEditor.AdminLicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CVDesktopEditor.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Licencias · CV Desktop Editor"
        Height="720" Width="900" MinHeight="560" MinWidth="600"
        Icon="/Assets/appicon.ico" WindowStartupLocation="CenterOwner"
        WindowStyle="None" Background="{DynamicResource AppBgBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="72"/>
        </Grid.RowDefinitions>
        <ui:AppTitleBar/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="42,32,42,38" MaxWidth="880" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="ADMINISTRACIÓN" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="Licencias" FontSize="33" FontWeight="SemiBold"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="Crea accesos premium para tus clientes."
                                   FontSize="14" Foreground="{DynamicResource MutedBrush}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                    <TextBlock Name="TxtServerStatus" Grid.Column="1" Text="Listo"
                               VerticalAlignment="Bottom" Margin="0,0,0,3"
                               Foreground="{DynamicResource AccentBrush}" FontSize="13"/>
                </Grid>

                <Border Grid.Row="2" Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrushSoft}"
                        BorderThickness="1" CornerRadius="7" Padding="18">
                    <Grid>
                        <StackPanel Name="CredentialEntryPanel">
                            <TextBlock Text="Conectar panel" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="Introduce la clave admin una vez en este equipo."
                                       FontSize="13" Foreground="{DynamicResource MutedBrush}"
                                       Margin="0,4,0,12"/>
                            <PasswordBox Name="TxtAdminKey" Height="42"/>
                        </StackPanel>
                        <Grid Name="CredentialSavedPanel" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Clave admin guardada" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="La clave está protegida en tu usuario de Windows."
                                           FontSize="13" Foreground="{DynamicResource MutedBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Cambiar clave" Width="132" Height="40"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BtnChangeAdminKey_Click"/>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Correo del cliente" FontWeight="SemiBold" Margin="0,0,0,7"/>
                        <TextBox Name="TxtEmail" Height="44"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Nombre del cliente" FontWeight="SemiBold" Margin="0,0,0,7"/>
                        <TextBox Name="TxtFullName" Height="44"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="Dispositivos permitidos" FontWeight="SemiBold" Margin="0,0,0,7"/>
                        <TextBox Name="TxtMaxDevices" Text="1" Height="44"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock Text="Vigencia · día / mes / año" FontWeight="SemiBold" Margin="0,0,0,7"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.7*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="0.7*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Name="TxtExpireDay" Height="44" MaxLength="2" ToolTip="Día"/>
                            <TextBox Name="TxtExpireMonth" Grid.Column="2" Height="44" MaxLength="2" ToolTip="Mes"/>
                            <TextBox Name="TxtExpireYear" Grid.Column="4" Height="44" MaxLength="4" ToolTip="Año"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Resultado" FontSize="18" FontWeight="SemiBold"/>
                    <TextBox Name="TxtResult" Grid.Row="2" Height="132"
                             AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True"
                             VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                </Grid>

                <StackPanel Grid.Row="8">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Clientes y licencias" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Name="TxtLicensesSummary" Text="Consultando licencias..."
                                       FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Actualizar" Width="110" Height="38"
                                VerticalAlignment="Center" Style="{StaticResource SecondaryButtonStyle}"
                                Click="BtnRefreshLicenses_Click"/>
                    </Grid>
                    <ItemsControl Name="LicenseList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource PanelBrush}"
                                        BorderBrush="{DynamicResource BorderBrushSoft}"
                                        BorderThickness="1" CornerRadius="6" Padding="14,11" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Email}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding FullName}" FontSize="12"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="16,0,0,0" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding StatusLabel}" HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock Text="{Binding Detail}" FontSize="12"
                                                       Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource ChromeBrush}"
                BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="0,1,0,0" Padding="22,12">
            <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Abrir instalador" Width="155" Height="44"
                            Margin="0,0,10,0" Style="{StaticResource SecondaryButtonStyle}"
                            Click="BtnBuildInstaller_Click"/>
                    <Button Content="Copiar clave" Width="126" Height="44"
                            Margin="0,0,10,0" Style="{StaticResource SecondaryButtonStyle}"
                            Click="BtnCopyLicense_Click"/>
                    <Button Name="BtnGenerateLicense" Content="Generar licencia" Width="174" Height="44"
                            Click="BtnGenerateLicense_Click"/>
            </WrapPanel>
        </Border>
    </Grid>
</Window>
