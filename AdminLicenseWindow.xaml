<Window x:Class="CVDesktopEditor.AdminLicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Panel admin"
        Height="650"
        Width="760"
        Icon="/Assets/appicon.ico"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBgBrush}">
    <Border Margin="22"
            Padding="26"
            CornerRadius="18"
            Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource BorderBrushSoft}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Panel admin"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="Genera licencias premium y prepara entregas para clientes."
                           Margin="0,8,0,0"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.ColumnSpan="3">
                    <TextBlock Text="Clave admin"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>
                    <PasswordBox Name="TxtAdminKey"
                                 Height="44"/>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="Correo del cliente"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>
                    <TextBox Name="TxtEmail"
                             Height="44"/>
                </StackPanel>

                <StackPanel Grid.Row="2"
                            Grid.Column="2">
                    <TextBlock Text="Nombre del cliente"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>
                    <TextBox Name="TxtFullName"
                             Height="44"/>
                </StackPanel>

                <StackPanel Grid.Row="4">
                    <TextBlock Text="Dispositivos permitidos"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>
                    <TextBox Name="TxtMaxDevices"
                             Text="1"
                             Height="44"/>
                </StackPanel>

                <StackPanel Grid.Row="4"
                            Grid.Column="2">
                    <TextBlock Text="Expira en"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>
                    <DatePicker Name="DateExpires"
                                Height="44"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="4"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16">
                <TextBox Name="TxtResult"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         IsReadOnly="True"
                         MinHeight="120"/>
            </Border>

            <StackPanel Grid.Row="5"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Crear instalador"
                        Width="150"
                        Height="44"
                        Margin="0,0,12,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BtnBuildInstaller_Click"/>
                <Button Content="Copiar clave"
                        Width="130"
                        Height="44"
                        Margin="0,0,12,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BtnCopyLicense_Click"/>
                <Button Content="Generar licencia"
                        Width="170"
                        Height="44"
                        Click="BtnGenerateLicense_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
