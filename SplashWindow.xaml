<Window x:Class="CVDesktopEditor.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CV Desktop Editor"
        Width="560"
        Height="320"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Border Background="#0B1020"
            BorderBrush="#27324D"
            BorderThickness="1"
            CornerRadius="22"
            Padding="34">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="CV Desktop Editor"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="#F8FAFC"/>
                <TextBlock Text="Professional resume workspace"
                           FontSize="15"
                           Foreground="#D6B36A"
                           Margin="0,8,0,0"/>
                <TextBlock x:Name="TxtStatus"
                           Text="Inicializando servicios..."
                           FontSize="13"
                           Foreground="#A7B0C0"
                           Margin="0,28,0,0"/>
            </StackPanel>

            <ProgressBar Grid.Row="1"
                         IsIndeterminate="True"
                         Height="6"
                         Background="#182235"
                         Foreground="#2563EB"
                         BorderThickness="0"/>
        </Grid>
    </Border>
</Window>
