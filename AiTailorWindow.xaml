<Window x:Class="CVDesktopEditor.AiTailorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CVDesktopEditor.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Ajustar con IA"
        Height="680"
        Width="980"
        MinHeight="560"
        MinWidth="600"
        Icon="/Assets/appicon.ico"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="{DynamicResource AppBgBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:AppTitleBar/>
    <Grid Grid.Row="1" Margin="30,24,30,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="Transparent" Padding="4,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Ajustar CV con IA"
                               FontSize="30"
                               FontWeight="Bold"/>
                    <TextBlock Text="Pega una descripcion de empleo y la IA ajustara resumen, proyectos y habilidades."
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Column="1" Height="42" VerticalAlignment="Center"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrushSoft}"
                        BorderThickness="1" CornerRadius="7" Padding="3">
                    <UniformGrid Rows="1" Columns="2">
                        <RadioButton Name="RbSpanish" Content="Español" GroupName="AiLanguage"
                                     IsChecked="True" Style="{StaticResource LanguageSegmentStyle}"/>
                        <RadioButton Name="RbEnglish" Content="English" GroupName="AiLanguage"
                                     Style="{StaticResource LanguageSegmentStyle}"/>
                    </UniformGrid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Descripcion del empleo"
                               FontSize="20"
                               FontWeight="SemiBold"/>
                    <TextBox Name="TxtJobDescription"
                             Grid.Row="2"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"/>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Resultado IA"
                               FontSize="20"
                               FontWeight="SemiBold"/>
                    <TextBox Name="TxtPreview"
                             Grid.Row="2"
                             AcceptsReturn="True"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"/>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="4"
                   Name="TxtStatus"
                   Foreground="{DynamicResource MutedBrush}"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"/>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cerrar"
                    Width="130"
                    Height="44"
                    Margin="0,0,12,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="BtnClose_Click"/>
            <Button Name="BtnApply"
                    Content="Aplicar al CV"
                    Width="150"
                    Height="44"
                    Margin="0,0,12,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsEnabled="False"
                    Click="BtnApply_Click"/>
            <Button Name="BtnGenerate"
                    Content="Generar ajuste"
                    Width="160"
                    Height="44"
                    Click="BtnGenerate_Click"/>
        </StackPanel>
    </Grid>
    </Grid>
</Window>
