<Window x:Class="CVDesktopEditor.LicenseActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CVDesktopEditor.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Activar licencia" Height="440" Width="640"
        MinHeight="440" MinWidth="560"
        Icon="/Assets/appicon.ico" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="None"
        Background="{DynamicResource AppBgBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:AppTitleBar/>
        <Grid Grid.Row="1" Margin="36,28,36,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Activar producto" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock Text="Introduce tu clave para usar la versión premium."
                           Foreground="{DynamicResource MutedBrush}" FontSize="14"
                           Margin="0,8,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="2">
                <TextBlock Text="Clave de licencia" FontWeight="SemiBold" Margin="0,0,0,7"/>
                <TextBox Name="TxtLicenseKey" Height="46"/>
            </StackPanel>

            <TextBlock Grid.Row="4" Name="TxtStatus"
                       TextWrapping="Wrap" FontSize="13" LineHeight="20"
                       Foreground="{DynamicResource MutedBrush}"/>

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="Comprar licencia" Width="146" Height="42"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BtnPurchase_Click"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Cancelar" Width="104" Height="42"
                            Margin="0,0,10,0" Style="{StaticResource SecondaryButtonStyle}"
                            Click="BtnCancel_Click"/>
                    <Button Content="Activar" Width="112" Height="42"
                            Click="BtnActivate_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
