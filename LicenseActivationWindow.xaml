<Window x:Class="CVDesktopEditor.LicenseActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Activar licencia"
        Height="430"
        Width="620"
        Icon="/Assets/appicon.ico"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppBgBrush}">
    <Border Margin="22"
            Padding="26"
            CornerRadius="18"
            Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Activar producto"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="Conecta esta instalación con tu servidor de licencias."
                           Margin="0,8,0,0"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Row="2">
                <TextBlock Text="URL de la API"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <TextBox Name="TxtApiUrl"
                         Height="44"/>
            </StackPanel>

            <StackPanel Grid.Row="4">
                <TextBlock Text="Clave de licencia"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <TextBox Name="TxtLicenseKey"
                         Height="44"/>
            </StackPanel>

            <TextBlock Grid.Row="5"
                       Name="TxtStatus"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Row="6"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Cancelar"
                        Width="130"
                        Height="44"
                        Margin="0,0,12,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BtnCancel_Click"/>
                <Button Content="Activar"
                        Width="150"
                        Height="44"
                        Click="BtnActivate_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
