<Window x:Class="CVDesktopEditor.LicenseActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Activar licencia"
        Height="500"
        Width="680"
        Icon="/Assets/appicon.ico"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppBgBrush}">
    <Border Margin="22"
            Padding="28"
            CornerRadius="18"
            Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource BorderBrushSoft}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="22"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Activar producto"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="Ingresa tu clave para desbloquear la version premium."
                           Margin="0,8,0,0"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"/>
                <TextBlock Text="Compra o soporte: +506 8713-8971 / jretanamendez@gmail.com"
                           Margin="0,8,0,0"
                           Foreground="{StaticResource AccentBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Row="2">
                <TextBlock Text="Clave de licencia"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <TextBox Name="TxtLicenseKey"
                         Height="44"/>
            </StackPanel>

            <Border Grid.Row="4"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14"
                    MinHeight="68">
                <TextBlock Name="TxtStatus"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           FontSize="14"
                           LineHeight="20"
                           VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Row="6"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,0,0,0">
                <Button Content="Cancelar"
                        Width="138"
                        Height="46"
                        Margin="0,0,12,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BtnCancel_Click"/>
                <Button Content="Activar"
                        Width="160"
                        Height="46"
                        Click="BtnActivate_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
