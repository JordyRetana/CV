<Window x:Class="CVDesktopEditor.AppDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CV Desktop Editor"
        SizeToContent="Height"
        Width="560"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/appicon.ico"
        Background="Transparent">
    <Border Margin="0"
            Padding="24"
            CornerRadius="18"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrushSoft}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel>
                <Button Name="BtnWindowClose"
                        Content="x"
                        Width="34"
                        Height="34"
                        Padding="0"
                        DockPanel.Dock="Right"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BtnWindowClose_Click"/>
                <Border Width="42"
                        Height="42"
                        CornerRadius="12"
                        Background="{DynamicResource PanelBrush}"
                        Margin="0,0,14,0"
                        DockPanel.Dock="Left">
                    <TextBlock Name="TxtIcon"
                               Text="i"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock Name="TxtTitle"
                           FontSize="24"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
            </DockPanel>

            <TextBlock Grid.Row="2"
                       Name="TxtMessage"
                       Foreground="{DynamicResource MutedBrush}"
                       FontSize="15"
                       LineHeight="23"
                       TextWrapping="Wrap"
                       MaxWidth="470"
                       VerticalAlignment="Top"/>

            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Name="BtnCancel"
                        Content="Cancelar"
                        Width="120"
                        Height="42"
                        Margin="0,0,12,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BtnCancel_Click"/>
                <Button Name="BtnOk"
                        Content="Aceptar"
                        Width="132"
                        Height="42"
                        Click="BtnOk_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
